{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "shopadvizor/catalog-shared-context": "^7.12.2",
        "symfony/console": "7.3.*",
        "symfony/dotenv": "7.3.*",
        "symfony/flex": "^2.4.7",
        "symfony/framework-bundle": "7.3.*",
        "symfony/messenger": "7.3.*",
        "symfony/runtime": "7.3.*",
        "symfony/twig-bundle": "7.3.*",
        "symfony/yaml": "7.3.*"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^12.0",
        "roave/security-advisories": "dev-latest",
        "shopadvizor/symfony-standards": "^2.8"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "audit": {
            "block-insecure": false
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Saz\\Game\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saz\\Game\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "scripts": {
        "php-fast": "php -d memory_limit=-1 -d xdebug.mode=off",
        "lint:fix": [
            "@php-fast vendor/bin/phpcbf --basepath=src/ src/",
            "@php-fast vendor/bin/php-cs-fixer fix"
        ],
        "lint": [
            "@php-fast vendor/bin/phpcs",
            "@php-fast vendor/bin/php-cs-fixer fix -v --dry-run --using-cache=no",
            "@php-fast vendor/bin/phpstan --memory-limit=256M analyse"
        ],
        "test": [
            "@php-fast bin/phpunit"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*",
            "docker": false
        }
    }
}
