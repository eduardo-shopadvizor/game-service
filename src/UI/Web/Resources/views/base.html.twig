<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Game Catalog{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gaming: {
                            bg: '#0a0a0f',
                            card: '#13131a',
                            border: '#1e1e2e',
                            accent: '#7c3aed',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full bg-gray-950 text-gray-100 antialiased">

    <header class="border-b border-gray-800 bg-gray-900/80 backdrop-blur sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <a href="{{ path('catalog_index') }}" class="flex items-center gap-3 group">
                    <span class="text-2xl">🎮</span>
                    <span class="font-bold text-lg tracking-tight text-white group-hover:text-violet-400 transition-colors">
                        Game Catalog
                    </span>
                </a>
                <nav class="hidden sm:flex items-center gap-6 text-sm text-gray-400">
                    <a href="{{ path('catalog_index') }}" class="hover:text-white transition-colors">All Games</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {% block content %}{% endblock %}
    </main>

    <footer class="mt-16 border-t border-gray-800 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-gray-600">
            Game Catalog &copy; {{ "now"|date("Y") }}
        </div>
    </footer>

</body>
</html>
