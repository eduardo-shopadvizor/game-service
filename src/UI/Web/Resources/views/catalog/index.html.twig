{% extends 'base.html.twig' %}

{% block title %}Game Catalog{% endblock %}

{% block content %}

<div class="flex flex-wrap items-start justify-between gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Game Catalog</h1>
        <p class="text-gray-500 dark:text-gray-400">{{ games|length }} game{{ games|length != 1 ? 's' : '' }}
            {% if currentGenre %} in <span class="text-violet-600 dark:text-violet-400 capitalize">{{ currentGenre }}</span>{% endif %}
        </p>
    </div>
    <button onclick="openAddGameModal()"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl
                   bg-violet-600 hover:bg-violet-500 active:bg-violet-700
                   text-white font-semibold text-sm
                   shadow-md shadow-violet-500/20 hover:shadow-violet-500/40
                   transition-all duration-200 hover:-translate-y-0.5 group">
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Add Game
    </button>
</div>

{# Genre filter pills #}
<div class="flex flex-wrap gap-2 mb-8">
    <a href="{{ path('catalog_index') }}"
       class="px-4 py-1.5 rounded-full text-sm font-medium border transition-all
              {% if currentGenre is null %}
                  bg-violet-600 text-white border-violet-600
              {% else %}
                  text-gray-700 dark:text-gray-400 border-gray-400 dark:border-gray-700 hover:text-gray-900 dark:hover:text-white hover:border-gray-500 dark:hover:border-gray-500 bg-white dark:bg-transparent
              {% endif %}">
        All
    </a>

    {% for genre in genres %}
        <a href="{{ path('catalog_index', {genre: genre.value}) }}"
           class="px-4 py-1.5 rounded-full text-sm font-medium border transition-all
                  {% if currentGenre == genre.value %}
                      {% if genre.value == 'action' %}bg-red-500/20 text-red-700 dark:text-red-300 border-red-400 dark:border-red-500/50
                      {% elseif genre.value == 'rpg' %}bg-purple-500/20 text-purple-700 dark:text-purple-300 border-purple-400 dark:border-purple-500/50
                      {% elseif genre.value == 'strategy' %}bg-blue-500/20 text-blue-700 dark:text-blue-300 border-blue-400 dark:border-blue-500/50
                      {% elseif genre.value == 'sports' %}bg-green-500/20 text-green-700 dark:text-green-300 border-green-400 dark:border-green-500/50
                      {% elseif genre.value == 'adventure' %}bg-yellow-500/20 text-yellow-700 dark:text-yellow-300 border-yellow-400 dark:border-yellow-500/50
                      {% endif %}
                  {% else %}
                      text-gray-700 dark:text-gray-400 border-gray-400 dark:border-gray-700 hover:text-gray-900 dark:hover:text-white hover:border-gray-500 dark:hover:border-gray-500 bg-white dark:bg-transparent
                  {% endif %}">
            {{ genre.value|capitalize }}
        </a>
    {% endfor %}
</div>

{# Games grid #}
{% if games|length > 0 %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {% for game in games %}
            {{ include('components/game_card.html.twig', {game: game}) }}
        {% endfor %}
    </div>
{% else %}
    <div class="flex flex-col items-center justify-center py-24 text-gray-400 dark:text-gray-600">
        <span class="text-5xl mb-4">🎮</span>
        <p class="text-lg font-medium">No games found</p>
        <a href="{{ path('catalog_index') }}" class="mt-4 text-sm text-violet-600 dark:text-violet-400 hover:text-violet-500 dark:hover:text-violet-300 transition-colors">
            Browse all games
        </a>
    </div>
{% endif %}

{% endblock %}

{% block extras %}

{# ── Floating Action Button ─────────────────────────────────────────── #}
<button onclick="openAddGameModal()"
        class="fixed bottom-8 right-8 z-40 flex items-center gap-2 px-5 py-3.5 rounded-full
               bg-violet-600 hover:bg-violet-500 active:bg-violet-700
               text-white font-bold text-sm
               shadow-lg shadow-violet-500/40 hover:shadow-xl hover:shadow-violet-500/60
               transition-all duration-200 hover:scale-105 active:scale-95 sm:hidden group">
    <svg class="w-5 h-5 transition-transform duration-300 group-hover:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    Add Game
</button>

{# ── Modal ──────────────────────────────────────────────────────────── #}
<div id="add-game-modal"
     class="fixed inset-0 z-50"
     style="display:none"
     aria-modal="true"
     role="dialog">

    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeAddGameModal()"></div>

    <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div id="add-game-panel"
             class="relative w-full max-w-lg rounded-2xl overflow-hidden pointer-events-auto
                    bg-white dark:bg-gray-900
                    border border-gray-200 dark:border-gray-700
                    shadow-2xl dark:shadow-black/60"
             style="transform: translateY(24px); opacity: 0; transition: transform 0.25s ease, opacity 0.25s ease">

            {# Header #}
            <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100 dark:border-gray-800">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">🎮</span>
                    <h2 class="text-lg font-bold text-gray-900 dark:text-white">Add New Game</h2>
                </div>
                <button type="button" onclick="closeAddGameModal()"
                        class="p-2 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200
                               hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            {# Form #}
            <form id="add-game-form" onsubmit="submitAddGame(event)" class="px-6 py-5 space-y-5">

                {# Name #}
                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">
                        Game Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="game-name"
                           placeholder="e.g. The Legend of Zelda"
                           required maxlength="100"
                           class="w-full px-4 py-2.5 rounded-xl text-sm
                                  bg-gray-50 dark:bg-gray-800
                                  border border-gray-200 dark:border-gray-700
                                  text-gray-900 dark:text-gray-100
                                  placeholder-gray-400 dark:placeholder-gray-500
                                  focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500
                                  transition-colors">
                </div>

                {# Description #}
                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">
                        Description
                        <span class="font-normal text-gray-400 dark:text-gray-500 text-xs">(optional)</span>
                    </label>
                    <textarea name="game-description" rows="3"
                              placeholder="A short description of the game..."
                              maxlength="500"
                              class="w-full px-4 py-2.5 rounded-xl text-sm resize-none
                                     bg-gray-50 dark:bg-gray-800
                                     border border-gray-200 dark:border-gray-700
                                     text-gray-900 dark:text-gray-100
                                     placeholder-gray-400 dark:placeholder-gray-500
                                     focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500
                                     transition-colors"></textarea>
                </div>

                {# Genre selector #}
                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                        Genre <span class="text-red-500">*</span>
                    </label>
                    <div class="grid grid-cols-5 gap-2">
                        {% set genreCards = [
                            {value: 'action',    emoji: '💥', label: 'Action',    gradient: 'linear-gradient(135deg,#450a0a 0%,#7f1d1d 60%,#b91c1c 100%)'},
                            {value: 'rpg',       emoji: '⚔️', label: 'RPG',       gradient: 'linear-gradient(135deg,#2e1065 0%,#4c1d95 60%,#6d28d9 100%)'},
                            {value: 'strategy',  emoji: '♟️', label: 'Strategy',  gradient: 'linear-gradient(135deg,#0c1a45 0%,#1e3a8a 60%,#1d4ed8 100%)'},
                            {value: 'sports',    emoji: '🏆', label: 'Sports',    gradient: 'linear-gradient(135deg,#052e16 0%,#14532d 60%,#15803d 100%)'},
                            {value: 'adventure', emoji: '🗺️', label: 'Adventure', gradient: 'linear-gradient(135deg,#451a03 0%,#92400e 60%,#b45309 100%)'},
                        ] %}
                        {% for card in genreCards %}
                        <label class="cursor-pointer">
                            <input type="radio" name="genre" value="{{ card.value }}" class="sr-only peer">
                            <div class="peer-checked:ring-2 peer-checked:ring-violet-400 peer-checked:ring-offset-2
                                        peer-checked:ring-offset-white dark:peer-checked:ring-offset-gray-900
                                        peer-checked:scale-105 peer-checked:opacity-100
                                        rounded-xl p-2.5 text-center select-none
                                        opacity-50 hover:opacity-75
                                        transition-all duration-200 cursor-pointer"
                                 style="background: {{ card.gradient }}">
                                <span class="text-xl block">{{ card.emoji }}</span>
                                <span class="text-[10px] font-bold text-white/90 uppercase tracking-wide mt-0.5 block leading-none">
                                    {{ card.label }}
                                </span>
                            </div>
                        </label>
                        {% endfor %}
                    </div>
                </div>

                {# Messages #}
                <div id="add-game-error"
                     class="hidden px-4 py-3 rounded-xl text-sm
                            text-red-700 dark:text-red-400
                            bg-red-50 dark:bg-red-900/20
                            border border-red-200 dark:border-red-800/50"></div>

                <div id="add-game-success"
                     class="hidden px-4 py-3 rounded-xl text-sm
                            text-green-700 dark:text-green-400
                            bg-green-50 dark:bg-green-900/20
                            border border-green-200 dark:border-green-800/50"></div>

                {# Actions #}
                <div class="flex items-center justify-end gap-3 pt-1">
                    <button type="button" onclick="closeAddGameModal()"
                            class="px-5 py-2.5 rounded-xl text-sm font-semibold
                                   text-gray-700 dark:text-gray-300
                                   bg-gray-100 dark:bg-gray-800
                                   hover:bg-gray-200 dark:hover:bg-gray-700
                                   transition-colors">
                        Cancel
                    </button>
                    <button type="submit" id="add-game-submit"
                            class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold
                                   bg-violet-600 hover:bg-violet-500
                                   disabled:opacity-60 disabled:cursor-not-allowed
                                   text-white shadow-md shadow-violet-500/20
                                   transition-all duration-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        Add Game
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

{# ── Scripts ─────────────────────────────────────────────────────────── #}
<script>
    const gameShowUrl = (id) =>
        '{{ path('catalog_show', {id: 'GAME_ID'}) }}'.replace('GAME_ID', id);

    function openAddGameModal() {
        const modal = document.getElementById('add-game-modal');
        const panel = document.getElementById('add-game-panel');
        modal.style.display = 'block';
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => requestAnimationFrame(() => {
            panel.style.transform = 'translateY(0)';
            panel.style.opacity  = '1';
        }));
        modal.querySelector('[name="game-name"]').focus();
    }

    function closeAddGameModal() {
        const modal = document.getElementById('add-game-modal');
        const panel = document.getElementById('add-game-panel');
        panel.style.transform = 'translateY(24px)';
        panel.style.opacity  = '0';
        setTimeout(() => {
            modal.style.display = 'none';
            document.getElementById('add-game-form').reset();
            document.getElementById('add-game-error').classList.add('hidden');
            document.getElementById('add-game-success').classList.add('hidden');
            const btn = document.getElementById('add-game-submit');
            btn.disabled = false;
            btn.className = btn.className
                .replace('bg-green-600', 'bg-violet-600 hover:bg-violet-500');
            btn.innerHTML = `
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
                Add Game`;
            document.body.style.overflow = '';
        }, 220);
    }

    async function submitAddGame(e) {
        e.preventDefault();

        const form     = document.getElementById('add-game-form');
        const errorEl  = document.getElementById('add-game-error');
        const successEl = document.getElementById('add-game-success');
        const btn      = document.getElementById('add-game-submit');

        errorEl.classList.add('hidden');
        successEl.classList.add('hidden');

        const name        = form.querySelector('[name="game-name"]').value.trim();
        const description = form.querySelector('[name="game-description"]').value.trim() || null;
        const genreInput  = form.querySelector('[name="genre"]:checked');

        if (!genreInput) {
            errorEl.textContent = 'Please select a genre.';
            errorEl.classList.remove('hidden');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = `
            <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            Adding...`;

        try {
            const res = await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    query: `mutation CreateGame($input: CreateGameInput!) {
                        createGame(input: $input) { id }
                    }`,
                    variables: { input: { name, description, genre: genreInput.value } }
                })
            });

            if (!res.ok) throw new Error(`Server error (${res.status})`);

            const json = await res.json();

            if (json.errors?.length) {
                throw new Error(json.errors[0].message || 'Could not create game');
            }

            const id = json.data?.createGame?.id;
            if (!id) throw new Error('Unexpected server response');

            btn.innerHTML = `
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                Added!`;
            btn.classList.replace('bg-violet-600', 'bg-green-600');

            successEl.textContent = '🎮 Game added! Redirecting…';
            successEl.classList.remove('hidden');

            setTimeout(() => { window.location.href = gameShowUrl(id); }, 900);

        } catch (err) {
            errorEl.textContent = err.message;
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.innerHTML = `
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
                Add Game`;
        }
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' &&
            document.getElementById('add-game-modal').style.display !== 'none') {
            closeAddGameModal();
        }
    });
</script>

{% endblock %}
