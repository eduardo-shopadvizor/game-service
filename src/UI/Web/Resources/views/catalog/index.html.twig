{% extends 'base.html.twig' %}

{% block title %}Game Catalog{% endblock %}

{% block content %}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-white mb-2">Game Catalog</h1>
    <p class="text-gray-400">{{ games|length }} game{{ games|length != 1 ? 's' : '' }}
        {% if currentGenre %} in <span class="text-violet-400 capitalize">{{ currentGenre }}</span>{% endif %}
    </p>
</div>

{# Genre filter pills #}
<div class="flex flex-wrap gap-2 mb-8">
    {% set genreStyles = {
        'action':    'hover:bg-red-500/20 hover:text-red-300 hover:border-red-500/50 data-active:bg-red-500/20 data-active:text-red-300 data-active:border-red-500/50',
        'rpg':       'hover:bg-purple-500/20 hover:text-purple-300 hover:border-purple-500/50 data-active:bg-purple-500/20 data-active:text-purple-300 data-active:border-purple-500/50',
        'strategy':  'hover:bg-blue-500/20 hover:text-blue-300 hover:border-blue-500/50 data-active:bg-blue-500/20 data-active:text-blue-300 data-active:border-blue-500/50',
        'sports':    'hover:bg-green-500/20 hover:text-green-300 hover:border-green-500/50 data-active:bg-green-500/20 data-active:text-green-300 data-active:border-green-500/50',
        'adventure': 'hover:bg-yellow-500/20 hover:text-yellow-300 hover:border-yellow-500/50 data-active:bg-yellow-500/20 data-active:text-yellow-300 data-active:border-yellow-500/50',
    } %}

    <a href="{{ path('catalog_index') }}"
       class="px-4 py-1.5 rounded-full text-sm font-medium border transition-all
              {% if currentGenre is null %}bg-violet-600 text-white border-violet-600{% else %}text-gray-400 border-gray-700 hover:text-white hover:border-gray-500{% endif %}">
        All
    </a>

    {% for genre in genres %}
        <a href="{{ path('catalog_index', {genre: genre.value}) }}"
           class="px-4 py-1.5 rounded-full text-sm font-medium border transition-all
                  {% if currentGenre == genre.value %}
                      {% if genre.value == 'action' %}bg-red-500/20 text-red-300 border-red-500/50
                      {% elseif genre.value == 'rpg' %}bg-purple-500/20 text-purple-300 border-purple-500/50
                      {% elseif genre.value == 'strategy' %}bg-blue-500/20 text-blue-300 border-blue-500/50
                      {% elseif genre.value == 'sports' %}bg-green-500/20 text-green-300 border-green-500/50
                      {% elseif genre.value == 'adventure' %}bg-yellow-500/20 text-yellow-300 border-yellow-500/50
                      {% endif %}
                  {% else %}text-gray-400 border-gray-700 hover:text-white hover:border-gray-500{% endif %}">
            {{ genre.value|capitalize }}
        </a>
    {% endfor %}
</div>

{# Games grid #}
{% if games|length > 0 %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {% for game in games %}
            {{ include('components/game_card.html.twig', {game: game}) }}
        {% endfor %}
    </div>
{% else %}
    <div class="flex flex-col items-center justify-center py-24 text-gray-600">
        <span class="text-5xl mb-4">🎮</span>
        <p class="text-lg font-medium">No games found</p>
        <a href="{{ path('catalog_index') }}" class="mt-4 text-sm text-violet-400 hover:text-violet-300 transition-colors">
            Browse all games
        </a>
    </div>
{% endif %}

{% endblock %}
