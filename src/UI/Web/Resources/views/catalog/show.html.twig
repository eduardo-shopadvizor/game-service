{% extends 'base.html.twig' %}

{% block title %}{{ game.name() }} — Game Catalog{% endblock %}

{% block content %}

{% set genreColors = {
    'action':    'bg-red-500/20 text-red-600 dark:text-red-400 ring-red-500/30',
    'rpg':       'bg-purple-500/20 text-purple-600 dark:text-purple-400 ring-purple-500/30',
    'strategy':  'bg-blue-500/20 text-blue-600 dark:text-blue-400 ring-blue-500/30',
    'sports':    'bg-green-500/20 text-green-600 dark:text-green-400 ring-green-500/30',
    'adventure': 'bg-yellow-500/20 text-yellow-600 dark:text-yellow-400 ring-yellow-500/30',
} %}
{% set genreGradients = {
    'action':    'linear-gradient(135deg,#450a0a 0%,#7f1d1d 60%,#b91c1c 100%)',
    'rpg':       'linear-gradient(135deg,#2e1065 0%,#4c1d95 60%,#6d28d9 100%)',
    'strategy':  'linear-gradient(135deg,#0c1a45 0%,#1e3a8a 60%,#1d4ed8 100%)',
    'sports':    'linear-gradient(135deg,#052e16 0%,#14532d 60%,#15803d 100%)',
    'adventure': 'linear-gradient(135deg,#451a03 0%,#92400e 60%,#b45309 100%)',
} %}
{% set genreEmojis = {
    'action':    '💥',
    'rpg':       '⚔️',
    'strategy':  '♟️',
    'sports':    '🏆',
    'adventure': '🗺️',
} %}
{% set genreColor = genreColors[game.genre().value] ?? 'bg-gray-500/20 text-gray-600 dark:text-gray-400 ring-gray-500/30' %}
{% set gradient   = genreGradients[game.genre().value] ?? 'linear-gradient(135deg,#1f2937 0%,#374151 100%)' %}
{% set emoji      = genreEmojis[game.genre().value] ?? '🎮' %}

<div class="mb-6 flex items-center justify-between">
    <a href="{{ path('catalog_index') }}"
       class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to catalog
    </a>
    <button onclick="openEditGameModal()"
            class="flex items-center gap-2 px-4 py-2 rounded-xl
                   bg-white dark:bg-gray-800
                   border border-gray-200 dark:border-gray-700
                   text-gray-700 dark:text-gray-300 text-sm font-semibold
                   hover:border-violet-400 dark:hover:border-violet-500 hover:text-violet-600 dark:hover:text-violet-400
                   shadow-sm transition-all duration-200 group">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit Game
    </button>
</div>

<div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">

    {# Cover #}
    <div class="rounded-2xl overflow-hidden border border-gray-300 dark:border-gray-800 shadow-lg dark:shadow-black/50"
         style="background: {{ gradient }}">
        <div class="aspect-video relative flex items-center justify-center">
            <span class="text-9xl opacity-20 select-none">{{ emoji }}</span>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            <p class="absolute bottom-6 left-6 right-6 text-white font-bold text-2xl drop-shadow-lg">{{ game.name() }}</p>
        </div>
    </div>

    {# Game info #}
    <div class="space-y-6 bg-white dark:bg-transparent rounded-2xl p-6 shadow-md dark:shadow-none border border-gray-200 dark:border-transparent">

        <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ring-1 {{ genreColor }} mb-3">
                {{ game.genre().value|upper }}
            </span>
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white leading-tight">{{ game.name() }}</h1>
        </div>

        {% if game.description() %}
            <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">{{ game.description() }}</p>
        {% endif %}

        <div class="pt-4 border-t border-gray-300 dark:border-gray-800 grid grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-gray-500 dark:text-gray-500 mb-1">Added</p>
                <p class="text-gray-900 dark:text-gray-200 font-medium">{{ game.createdAt()|date('F j, Y') }}</p>
            </div>
            <div>
                <p class="text-gray-500 dark:text-gray-500 mb-1">Last updated</p>
                <p class="text-gray-900 dark:text-gray-200 font-medium">{{ game.updatedAt()|date('F j, Y') }}</p>
            </div>
        </div>

        <div class="pt-2">
            <a href="{{ path('catalog_index', {genre: game.genre().value}) }}"
               class="inline-flex items-center gap-2 text-sm text-violet-600 dark:text-violet-400 hover:text-violet-500 dark:hover:text-violet-300 transition-colors">
                Browse more {{ game.genre().value }} games →
            </a>
        </div>

    </div>
</div>

{% endblock %}

{% block extras %}

{# Edit Game Modal #}
<div id="edit-game-modal"
     class="fixed inset-0 z-50"
     style="display:none"
     aria-modal="true"
     role="dialog">

    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeEditGameModal()"></div>

    <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div id="edit-game-panel"
             class="relative w-full max-w-lg rounded-2xl overflow-hidden pointer-events-auto
                    bg-white dark:bg-gray-900
                    border border-gray-200 dark:border-gray-700
                    shadow-2xl dark:shadow-black/60"
             style="transform: translateY(24px); opacity: 0; transition: transform 0.25s ease, opacity 0.25s ease">

            <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100 dark:border-gray-800">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">✏️</span>
                    <h2 class="text-lg font-bold text-gray-900 dark:text-white">Edit Game</h2>
                </div>
                <button type="button" onclick="closeEditGameModal()"
                        class="p-2 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200
                               hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <form id="edit-game-form" onsubmit="submitEditGame(event)" class="px-6 py-5 space-y-5">

                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">
                        Game Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="game-name"
                           value="{{ game.name() }}"
                           required maxlength="100"
                           class="w-full px-4 py-2.5 rounded-xl text-sm
                                  bg-gray-50 dark:bg-gray-800
                                  border border-gray-200 dark:border-gray-700
                                  text-gray-900 dark:text-gray-100
                                  placeholder-gray-400 dark:placeholder-gray-500
                                  focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500
                                  transition-colors">
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">
                        Description
                        <span class="font-normal text-gray-400 dark:text-gray-500 text-xs">(optional)</span>
                    </label>
                    <textarea name="game-description" rows="3"
                              maxlength="500"
                              class="w-full px-4 py-2.5 rounded-xl text-sm resize-none
                                     bg-gray-50 dark:bg-gray-800
                                     border border-gray-200 dark:border-gray-700
                                     text-gray-900 dark:text-gray-100
                                     placeholder-gray-400 dark:placeholder-gray-500
                                     focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500
                                     transition-colors">{{ game.description() }}</textarea>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                        Genre <span class="text-red-500">*</span>
                    </label>
                    <div class="grid grid-cols-5 gap-2">
                        {% set genreCards = [
                            {value: 'action',    emoji: '💥', label: 'Action',    gradient: 'linear-gradient(135deg,#450a0a 0%,#7f1d1d 60%,#b91c1c 100%)'},
                            {value: 'rpg',       emoji: '⚔️', label: 'RPG',       gradient: 'linear-gradient(135deg,#2e1065 0%,#4c1d95 60%,#6d28d9 100%)'},
                            {value: 'strategy',  emoji: '♟️', label: 'Strategy',  gradient: 'linear-gradient(135deg,#0c1a45 0%,#1e3a8a 60%,#1d4ed8 100%)'},
                            {value: 'sports',    emoji: '🏆', label: 'Sports',    gradient: 'linear-gradient(135deg,#052e16 0%,#14532d 60%,#15803d 100%)'},
                            {value: 'adventure', emoji: '🗺️', label: 'Adventure', gradient: 'linear-gradient(135deg,#451a03 0%,#92400e 60%,#b45309 100%)'},
                        ] %}
                        {% for card in genreCards %}
                        <label class="cursor-pointer">
                            <input type="radio" name="genre" value="{{ card.value }}"
                                   {{ game.genre().value == card.value ? 'checked' : '' }}
                                   class="sr-only peer">
                            <div class="peer-checked:ring-2 peer-checked:ring-violet-400 peer-checked:ring-offset-2
                                        peer-checked:ring-offset-white dark:peer-checked:ring-offset-gray-900
                                        peer-checked:scale-105 peer-checked:opacity-100
                                        rounded-xl p-2.5 text-center select-none
                                        opacity-50 hover:opacity-75
                                        transition-all duration-200 cursor-pointer"
                                 style="background: {{ card.gradient }}">
                                <span class="text-xl block">{{ card.emoji }}</span>
                                <span class="text-[10px] font-bold text-white/90 uppercase tracking-wide mt-0.5 block leading-none">
                                    {{ card.label }}
                                </span>
                            </div>
                        </label>
                        {% endfor %}
                    </div>
                </div>

                <div id="edit-game-error"
                     class="hidden px-4 py-3 rounded-xl text-sm
                            text-red-700 dark:text-red-400
                            bg-red-50 dark:bg-red-900/20
                            border border-red-200 dark:border-red-800/50"></div>

                <div class="flex items-center justify-end gap-3 pt-1">
                    <button type="button" onclick="closeEditGameModal()"
                            class="px-5 py-2.5 rounded-xl text-sm font-semibold
                                   text-gray-700 dark:text-gray-300
                                   bg-gray-100 dark:bg-gray-800
                                   hover:bg-gray-200 dark:hover:bg-gray-700
                                   transition-colors">
                        Cancel
                    </button>
                    <button type="submit" id="edit-game-submit"
                            class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold
                                   bg-violet-600 hover:bg-violet-500
                                   disabled:opacity-60 disabled:cursor-not-allowed
                                   text-white shadow-md shadow-violet-500/20
                                   transition-all duration-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    const GAME_ID = '{{ game.id() }}';

    function openEditGameModal() {
        const modal = document.getElementById('edit-game-modal');
        const panel = document.getElementById('edit-game-panel');
        modal.style.display = 'block';
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => requestAnimationFrame(() => {
            panel.style.transform = 'translateY(0)';
            panel.style.opacity  = '1';
        }));
        modal.querySelector('[name="game-name"]').focus();
    }

    function closeEditGameModal() {
        const modal = document.getElementById('edit-game-modal');
        const panel = document.getElementById('edit-game-panel');
        panel.style.transform = 'translateY(24px)';
        panel.style.opacity  = '0';
        setTimeout(() => {
            modal.style.display = 'none';
            document.getElementById('edit-game-error').classList.add('hidden');
            const btn = document.getElementById('edit-game-submit');
            btn.disabled = false;
            btn.innerHTML = `
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                Save Changes`;
            document.body.style.overflow = '';
        }, 220);
    }

    async function submitEditGame(e) {
        e.preventDefault();

        const form    = document.getElementById('edit-game-form');
        const errorEl = document.getElementById('edit-game-error');
        const btn     = document.getElementById('edit-game-submit');

        errorEl.classList.add('hidden');

        const name        = form.querySelector('[name="game-name"]').value.trim();
        const description = form.querySelector('[name="game-description"]').value.trim() || null;
        const genreInput  = form.querySelector('[name="genre"]:checked');

        if (!genreInput) {
            errorEl.textContent = 'Please select a genre.';
            errorEl.classList.remove('hidden');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = `
            <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            Saving...`;

        try {
            const res = await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    query: `mutation UpdateGame($id: ID!, $input: UpdateGameInput!) {
                        updateGame(id: $id, input: $input) { id }
                    }`,
                    variables: {
                        id: GAME_ID,
                        input: { name, description, genre: genreInput.value }
                    }
                })
            });

            if (!res.ok) throw new Error(`Server error (${res.status})`);

            const json = await res.json();
            if (json.errors?.length) throw new Error(json.errors[0].message || 'Could not update game');

            window.location.reload();

        } catch (err) {
            errorEl.textContent = err.message;
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.innerHTML = `
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                Save Changes`;
        }
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' &&
            document.getElementById('edit-game-modal').style.display !== 'none') {
            closeEditGameModal();
        }
    });
</script>

{% endblock %}
