{% set genreColors = {
    'action':    'bg-red-500/20 text-red-600 dark:text-red-400 ring-red-500/30',
    'rpg':       'bg-purple-500/20 text-purple-600 dark:text-purple-400 ring-purple-500/30',
    'strategy':  'bg-blue-500/20 text-blue-600 dark:text-blue-400 ring-blue-500/30',
    'sports':    'bg-green-500/20 text-green-600 dark:text-green-400 ring-green-500/30',
    'adventure': 'bg-yellow-500/20 text-yellow-600 dark:text-yellow-400 ring-yellow-500/30',
} %}
{% set genreGradients = {
    'action':    'linear-gradient(135deg,#450a0a 0%,#7f1d1d 60%,#b91c1c 100%)',
    'rpg':       'linear-gradient(135deg,#2e1065 0%,#4c1d95 60%,#6d28d9 100%)',
    'strategy':  'linear-gradient(135deg,#0c1a45 0%,#1e3a8a 60%,#1d4ed8 100%)',
    'sports':    'linear-gradient(135deg,#052e16 0%,#14532d 60%,#15803d 100%)',
    'adventure': 'linear-gradient(135deg,#451a03 0%,#92400e 60%,#b45309 100%)',
} %}
{% set genreEmojis = {
    'action':    '💥',
    'rpg':       '⚔️',
    'strategy':  '♟️',
    'sports':    '🏆',
    'adventure': '🗺️',
} %}
{% set genreColor = genreColors[game.genre().value] ?? 'bg-gray-500/20 text-gray-600 dark:text-gray-400 ring-gray-500/30' %}
{% set gradient   = genreGradients[game.genre().value] ?? 'linear-gradient(135deg,#1f2937 0%,#374151 100%)' %}
{% set emoji      = genreEmojis[game.genre().value] ?? '🎮' %}

<a href="{{ path('catalog_show', {id: game.id()}) }}"
   class="group block bg-white dark:bg-gray-900 rounded-xl border border-gray-300 dark:border-gray-800 overflow-hidden
          shadow-sm dark:shadow-none hover:border-violet-400 dark:hover:border-violet-500/50 hover:shadow-md hover:shadow-violet-500/10
          transition-all duration-300 hover:-translate-y-1">

    <div class="aspect-video relative overflow-hidden" style="background: {{ gradient }}">
        <div class="absolute inset-0 flex items-center justify-center group-hover:scale-110 transition-transform duration-500">
            <span class="text-7xl opacity-20 select-none">{{ emoji }}</span>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
        <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ring-1 {{ genreColor }} bg-black/30 text-white ring-white/20">
            {{ game.genre().value|upper }}
        </span>
        <p class="absolute bottom-3 left-3 right-3 text-white font-bold text-sm drop-shadow line-clamp-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            {{ game.name() }}
        </p>
    </div>

    <div class="p-4">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors line-clamp-1">
            {{ game.name() }}
        </h3>
        {% if game.description() %}
            <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400 line-clamp-2">{{ game.description() }}</p>
        {% endif %}
        <p class="mt-3 text-xs text-gray-400 dark:text-gray-600">
            Added {{ game.createdAt()|date('M Y') }}
        </p>
    </div>
</a>
