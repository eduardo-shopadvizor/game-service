{% set genreColors = {
    'action':    'bg-red-500/20 text-red-400 ring-red-500/30',
    'rpg':       'bg-purple-500/20 text-purple-400 ring-purple-500/30',
    'strategy':  'bg-blue-500/20 text-blue-400 ring-blue-500/30',
    'sports':    'bg-green-500/20 text-green-400 ring-green-500/30',
    'adventure': 'bg-yellow-500/20 text-yellow-400 ring-yellow-500/30',
} %}
{% set genreColor = genreColors[game.genre().value] ?? 'bg-gray-500/20 text-gray-400 ring-gray-500/30' %}

<a href="{{ path('catalog_show', {id: game.id()}) }}"
   class="group block bg-gray-900 rounded-xl border border-gray-800 overflow-hidden
          hover:border-violet-500/50 hover:shadow-lg hover:shadow-violet-500/10
          transition-all duration-300 hover:-translate-y-1">

    <div class="aspect-video bg-gray-800 relative overflow-hidden">
        <img src="https://picsum.photos/seed/{{ game.id() }}/640/360"
             alt="{{ game.name() }}"
             class="w-full h-full object-cover opacity-70 group-hover:opacity-90 group-hover:scale-105 transition-all duration-500">
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent"></div>
        <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ring-1 {{ genreColor }}">
            {{ game.genre().value|upper }}
        </span>
    </div>

    <div class="p-4">
        <h3 class="font-semibold text-gray-100 group-hover:text-violet-400 transition-colors line-clamp-1">
            {{ game.name() }}
        </h3>
        {% if game.description() %}
            <p class="mt-1.5 text-sm text-gray-400 line-clamp-2">{{ game.description() }}</p>
        {% endif %}
        <p class="mt-3 text-xs text-gray-600">
            Added {{ game.createdAt()|date('M Y') }}
        </p>
    </div>
</a>
