{% set genreGradients = {
    'action':    'linear-gradient(135deg,#450a0a 0%,#7f1d1d 60%,#b91c1c 100%)',
    'rpg':       'linear-gradient(135deg,#2e1065 0%,#4c1d95 60%,#6d28d9 100%)',
    'strategy':  'linear-gradient(135deg,#0c1a45 0%,#1e3a8a 60%,#1d4ed8 100%)',
    'sports':    'linear-gradient(135deg,#052e16 0%,#14532d 60%,#15803d 100%)',
    'adventure': 'linear-gradient(135deg,#451a03 0%,#92400e 60%,#b45309 100%)',
} %}
{% set genreColors = {
    'action':    'bg-red-500/20 text-red-700 dark:text-red-400 ring-red-400/40',
    'rpg':       'bg-purple-500/20 text-purple-700 dark:text-purple-400 ring-purple-400/40',
    'strategy':  'bg-blue-500/20 text-blue-700 dark:text-blue-400 ring-blue-400/40',
    'sports':    'bg-green-500/20 text-green-700 dark:text-green-400 ring-green-400/40',
    'adventure': 'bg-yellow-500/20 text-yellow-700 dark:text-yellow-400 ring-yellow-400/40',
} %}
{% set genreEmojis = {
    'action':    '💥',
    'rpg':       '⚔️',
    'strategy':  '♟️',
    'sports':    '🏆',
    'adventure': '🗺️',
} %}
{% set gradient   = genreGradients[game.genre().value] ?? 'linear-gradient(135deg,#1f2937 0%,#374151 100%)' %}
{% set genreColor = genreColors[game.genre().value] ?? 'bg-gray-500/20 text-gray-600 dark:text-gray-400 ring-gray-400/40' %}
{% set emoji      = genreEmojis[game.genre().value] ?? '🎮' %}

<a href="{{ path('catalog_show', {id: game.id()}) }}"
   class="group flex items-center gap-4
          bg-white dark:bg-gray-900
          rounded-xl border border-gray-200 dark:border-gray-800
          shadow-md dark:shadow-none
          hover:border-violet-400 dark:hover:border-violet-500/50
          hover:shadow-lg hover:shadow-violet-500/10
          transition-all duration-200 p-3 overflow-hidden">

    {# Mini cover #}
    <div class="w-16 h-16 flex-shrink-0 rounded-lg overflow-hidden relative"
         style="background: {{ gradient }}">
        <span class="absolute inset-0 flex items-center justify-center text-2xl opacity-25 select-none group-hover:scale-110 transition-transform duration-300">
            {{ emoji }}
        </span>
    </div>

    {# Title + description #}
    <div class="flex-1 min-w-0">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100
                   group-hover:text-violet-600 dark:group-hover:text-violet-400
                   transition-colors truncate">
            {{ game.name() }}
        </h3>
        {% if game.description() %}
            <p class="text-sm text-gray-600 dark:text-gray-400 truncate mt-0.5">
                {{ game.description() }}
            </p>
        {% else %}
            <p class="text-sm text-gray-400 dark:text-gray-600 mt-0.5 italic">No description</p>
        {% endif %}
    </div>

    {# Genre + date #}
    <div class="flex-shrink-0 flex flex-col items-end gap-1.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ring-1 {{ genreColor }}">
            {{ game.genre().value|upper }}
        </span>
        <span class="text-xs text-gray-500 dark:text-gray-600">
            {{ game.createdAt()|date('M Y') }}
        </span>
    </div>

</a>
